<%@ include file="includes/head.jsp" %><div class="app-shell"><%@ include file="includes/sidebar.jsp" %><main class="workspace"><%@ include file="includes/topbar.jsp" %><div class="content page-enter">
<section class="welcome"><div><span class="eyebrow">ROLE WORKSPACE</span><h2>Welcome, <c:out value="${currentUser.fullName}"/>.</h2><p>Organization Overview</p></div><span class="role-badge"><c:out value="${currentUser.role.replace('_',' ')}"/></span></section>
<c:choose><c:when test="${currentUser.role=='EMPLOYEE'}"><div class="kpis"><article><span>Attendance records</span><strong data-count="${stats.ownAttendance}">0</strong><small>Your verified history</small></article><article><span>Pending leave</span><strong data-count="${stats.ownLeave}">0</strong><small>Your active requests</small></article><article><span>Active goals</span><strong data-count="${stats.ownGoals}">0</strong><small>Your current KPIs</small></article><article><span>Payslips</span><strong data-count="${stats.ownPayslips}">0</strong><small>Your payroll history</small></article></div></c:when><c:otherwise><div class="kpis"><article><span>Active employees</span><strong data-count="${stats.activeEmployees}">0</strong><small>Central workforce</small></article><c:if test="${currentUser.role!='HR_MANAGER'}"><article><span>Present today</span><strong data-count="${stats.presentToday}">0</strong><small>Live attendance</small></article></c:if><article><span>Leave decisions</span><strong data-count="${stats.pendingLeave}">0</strong><small>Awaiting review</small></article><article><span>Recent reviews</span><strong data-count="${stats.reviews}">0</strong><small>Last six months</small></article></div></c:otherwise></c:choose>
<div class="dashboard-grid"><c:if test="${currentUser.role!='EMPLOYEE'}"><section class="panel overview"><div class="panel-title"><div><span class="eyebrow">WORKFORCE SUMMARY</span><h3>Organization Summary</h3></div><span class="status-dot">Live data</span></div><div class="bars"><c:if test="${currentUser.role!='HR_MANAGER'}"><label>Attendance readiness<span>${stats.presentToday} today</span><i><b style="width:${stats.activeEmployees==0?0:(stats.presentToday*100/stats.activeEmployees)}%"></b></i></label></c:if><label>Review activity<span>${stats.reviews} recorded</span><i><b class="teal" style="width:${stats.reviews>100?100:stats.reviews}%"></b></i></label><label>Payroll preparation<span>${stats.openPayroll} open run(s)</span><i><b class="gold" style="width:${stats.openPayroll>0?70:15}%"></b></i></label></div></section></c:if><section class="panel quick"><span class="eyebrow">QUICK START</span><h3>Your permitted modules</h3><div class="quick-links"><a href="${pageContext.request.contextPath}/app/notifications"><b>${stats.unread}</b><span>Unread alerts</span></a><a href="${pageContext.request.contextPath}/app/account"><b>SEC</b><span>Account security</span></a><c:if test="${currentUser.role!='EMPLOYEE'}"><a href="${pageContext.request.contextPath}/app/reports"><b>CSV</b><span>Export reports</span></a></c:if></div></section></div>
</div><%@ include file="includes/foot.jsp" %>
