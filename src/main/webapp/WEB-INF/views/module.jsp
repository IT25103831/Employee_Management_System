<%@ include file="includes/head.jsp" %><div class="app-shell"><%@ include file="includes/sidebar.jsp" %><main class="workspace"><%@ include file="includes/topbar.jsp" %><div class="content page-enter">
<c:if test="${not empty flashMessage}"><div class="alert ${flashType}"><c:out value="${flashMessage}"/></div></c:if>

<c:choose>
<c:when test="${module=='employees'}">
 <section class="section-lead employees-lead"><div><span class="eyebrow">Employees</span><h2>Employee Management</h2><p>Create, locate, update and safely deactivate employee profiles.</p></div><form class="search"><input name="q" value="${fn:escapeXml(param.q)}" placeholder="Search name or code"><label>Department<input name="department" value="${fn:escapeXml(param.department)}" placeholder="Exact department name"></label><label>Designation<input name="designation" value="${fn:escapeXml(param.designation)}" placeholder="Exact designation name"></label><label>Status<select name="status"><option value="">All</option><option>ACTIVE</option><option>INACTIVE</option></select></label><button class="button">Search</button></form></section>
 <c:if test="${currentUser.role=='HR_MANAGER'}"><details class="panel form-panel"><summary>Add employee profile</summary><form method="post" class="form-grid"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="create"><label>Employee code<input name="employeeCode" pattern="[A-Za-z0-9-]{3,20}" required></label><label>Full name<input name="fullName" maxlength="120" required></label><label>NIC<input name="nic" maxlength="20" required></label><label>Date of birth<input type="date" name="dob" required></label><label>Email<input type="email" name="email" required></label><label>Phone<input name="phone" maxlength="20" required></label><label class="span-2">Address<input name="address" maxlength="250" required></label><label>Department<select name="departmentId" required><c:forEach items="${departments}" var="d"><option value="${fn:escapeXml(d.department_id)}"><c:out value="${d.department_name}"/></option></c:forEach></select></label><label>Designation<select name="designationId" required><c:forEach items="${designations}" var="d"><option value="${fn:escapeXml(d.designation_id)}"><c:out value="${d.designation_name}"/></option></c:forEach></select></label><label>Employment date<input type="date" name="employmentDate" required></label><label>Username<input name="username" pattern="[A-Za-z0-9_.-]{3,60}" required autocomplete="off"></label><label>Temporary password<input type="password" name="password" minlength="8" maxlength="128" required autocomplete="new-password"></label><p class="hint">An Employee account is created. IT manages role changes. The temporary password expires after 24 hours.</p><button class="button primary">Create profile and account</button></form></details></c:if>
 <section class="panel table-panel"><div class="panel-title"><div><span class="eyebrow">EMPLOYEE DIRECTORY</span><h3>${records.size()} records</h3></div></div><div class="table-wrap"><table><thead><tr><th>Employee</th><th>Contact</th><th>Assignment</th><th>Joined</th><th>Status</th><c:if test="${currentUser.role=='HR_MANAGER'}"><th>Actions</th></c:if></tr></thead><tbody><c:forEach items="${records}" var="r"><tr><td><b><c:out value="${r.full_name}"/></b><small><c:out value="${r.employee_code}"/> &middot; <c:out value="${r.nic}"/></small></td><td><c:out value="${r.email}"/><small><c:out value="${r.phone}"/></small></td><td><c:out value="${r.department_name}"/><small><c:out value="${r.designation_name}"/></small></td><td><c:out value="${r.employment_date}"/></td><td><span class="badge ${r.status=='ACTIVE'?'ok':'muted'}"><c:out value="${r.status}"/></span></td><c:if test="${currentUser.role=='HR_MANAGER'}"><td><details class="row-menu"><summary>Edit</summary><form method="post" class="mini-form"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="update"><input type="hidden" name="id" value="${fn:escapeXml(r.employee_id)}"><input type="email" name="email" value="${fn:escapeXml(r.email)}" required><input name="phone" value="${fn:escapeXml(r.phone)}" required><select name="departmentId"><c:forEach items="${departments}" var="d"><option value="${fn:escapeXml(d.department_id)}" ${r.department_id==d.department_id?'selected':''}>${fn:escapeXml(d.department_name)}</option></c:forEach></select><select name="designationId"><c:forEach items="${designations}" var="d"><option value="${fn:escapeXml(d.designation_id)}" ${r.designation_id==d.designation_id?'selected':''}>${fn:escapeXml(d.designation_name)}</option></c:forEach></select><label>Employment status<select name="status" required><option value="ACTIVE" ${r.status=='ACTIVE'?'selected':''}>Active</option><option value="INACTIVE" ${r.status=='INACTIVE'?'selected':''}>Inactive</option></select></label><button class="button">Save</button></form><c:if test="${r.status=='ACTIVE'}"><form method="post" data-confirm="Deactivate this employee profile?"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="deactivate"><input type="hidden" name="id" value="${fn:escapeXml(r.employee_id)}"><button class="button danger">Deactivate</button></form></c:if></details></td></c:if></tr></c:forEach><c:if test="${empty records}"><tr><td colspan="6" class="empty">No employee records match this search.</td></tr></c:if></tbody></table></div></section><section class="panel table-panel"><div class="panel-title"><div><span class="eyebrow">PROFILE HISTORY</span><h3>Recent profile changes</h3></div></div><div class="table-wrap"><table><thead><tr><th>Employee</th><th>Action</th><th>Details</th><th>Changed by</th><th>Time</th></tr></thead><tbody><c:forEach items="${history}" var="h"><tr><td>${fn:escapeXml(h.employee_code)} - ${fn:escapeXml(h.full_name)}</td><td><span class="badge">${fn:escapeXml(h.action_name)}</span></td><td>${fn:escapeXml(h.details)}</td><td>${fn:escapeXml(h.username)}</td><td>${fn:escapeXml(h.changed_at)}</td></tr></c:forEach><c:if test="${empty history}"><tr><td colspan="5" class="empty">No profile changes have been recorded yet.</td></tr></c:if></tbody></table></div></section>
</c:when>

<c:when test="${module=='attendance'}">
 <section class="section-lead attendance-lead"><div><span class="eyebrow">ATTENDANCE</span><h2>Attendance Management</h2><p>Daily attendance, optional shifts and working-hour summaries.</p></div><c:if test="${currentUser.role=='EMPLOYEE'}"><div class="clock-actions"><form method="post"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="clockin"><button class="button primary">Clock in now</button></form><form method="post"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="clockout"><button class="button">Clock out</button></form></div></c:if></section>
 <c:if test="${currentUser.role=='ATTENDANCE_COORDINATOR'}"><details class="panel form-panel"><summary>Assign employee shift</summary><form method="post" class="form-grid"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="assign"><label>Employee<select name="employeeId"><c:forEach items="${employees}" var="e"><option value="${fn:escapeXml(e.employee_id)}">${fn:escapeXml(e.employee_code)} - ${fn:escapeXml(e.full_name)}</option></c:forEach></select></label><label>Shift<select name="shiftId"><c:forEach items="${shifts}" var="s"><option value="${fn:escapeXml(s.shift_id)}">${fn:escapeXml(s.shift_name)} (${fn:escapeXml(s.start_time)}-${fn:escapeXml(s.end_time)})</option></c:forEach></select></label><label>Start date<input type="date" name="startDate" required></label><label>End date<input type="date" name="endDate"></label><button class="button primary">Assign shift</button></form></details></c:if>
 <section class="panel table-panel"><div class="panel-title"><div><span class="eyebrow">RECENT ATTENDANCE</span><h3>Verified work records</h3></div><c:if test="${currentUser.role!='EMPLOYEE' and currentUser.role!='PAYROLL_SPECIALIST'}"><a class="button" href="${pageContext.request.contextPath}/export?report=attendance">Export CSV</a></c:if></div><div class="table-wrap"><table><thead><tr><th>ID</th><th>Employee</th><th>Date</th><th>Shift</th><th>Clock in</th><th>Clock out</th><th>Hours</th><th>Exception</th></tr></thead><tbody><c:forEach items="${records}" var="r"><tr><td>${fn:escapeXml(r.attendance_id)}</td><td><b>${fn:escapeXml(r.full_name)}</b><small>${fn:escapeXml(r.employee_code)}</small></td><td>${fn:escapeXml(r.work_date)}</td><td>${fn:escapeXml(r.shift_name)}</td><td>${fn:escapeXml(r.clock_in)}</td><td>${fn:escapeXml(r.clock_out)}</td><td>${fn:escapeXml(r.hours_worked)}</td><td><span class="badge ${empty r.exception_type?'ok':'warn'}">${empty r.exception_type?'CLEAR':r.exception_type}</span></td></tr></c:forEach><c:if test="${empty records}"><tr><td colspan="7" class="empty">No attendance records yet.</td></tr></c:if></tbody></table></div></section>
<section class="panel"><h3>Weekly / monthly attendance summary</h3><form method="get" class="form-grid"><label>Period<select name="period"><option value="month">Monthly</option><option value="week" ${param.period=='week'?'selected':''}>Weekly</option></select></label><label>Date within period<input type="date" name="date" value="${from}" required></label><button class="button">View summary</button></form><p>${from} to ${to}. Present excludes late; hours exclude the scheduled break.</p><c:if test="${currentUser.role!='EMPLOYEE' and currentUser.role!='PAYROLL_SPECIALIST'}"><a class="button" href="${pageContext.request.contextPath}/export?report=attendance-summary&amp;from=${from}&amp;to=${to}">Export selected summary</a></c:if><%@ include file="includes/summary.jsp" %></section><c:if test="${currentUser.role=='ATTENDANCE_COORDINATOR'}"><details class="panel form-panel"><summary>Record or correct attendance</summary><form method="post" class="form-grid"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="record"><label>Attendance ID (blank for new)<input type="number" name="id" ></label><label>Employee<select name="employeeId"><c:forEach items="${employees}" var="e"><c:if test="${e.status=='ACTIVE'}"><option value="${fn:escapeXml(e.employee_id)}">${fn:escapeXml(e.employee_code)} - ${fn:escapeXml(e.full_name)}</option></c:if></c:forEach></select></label><label>Working date<input type="date" name="workDate" required></label><label>Clock in<input type="datetime-local" name="clockIn" required></label><label>Clock out (optional)<input type="datetime-local" name="clockOut" ></label><label>Reason<input type="text" name="reason" required maxlength="300"></label><button class="button primary">Save attendance</button></form></details><details class="panel form-panel"><summary>Void an erroneous attendance record</summary><form method="post" class="form-grid" data-confirm="Void this record? Its correction history is retained."><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="void"><label>Attendance ID<input type="number" name="id" required></label><label>Reason<input type="text" name="reason" required maxlength="300"></label><button class="button danger">Void record</button></form></details></c:if>
<c:if test="${currentUser.role=='ATTENDANCE_COORDINATOR'}"><section class="panel"><h3>Assigned shifts</h3><c:set var="summary" value="${assignments}"/><%@ include file="includes/summary.jsp" %><details class="form-panel"><summary>End an assignment to plan a new shift</summary><p>End the current assignment, then assign the replacement starting the following day.</p><form method="post" class="form-grid" data-confirm="End this assignment on the selected date?"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="endAssignment"><label>Assignment ID<input type="number" name="id" required></label><label>Last working date<input type="date" name="endDate" required></label><button class="button">End assignment</button></form></details></section></c:if>
</c:when>

<c:when test="${module=='leave'}">
 <section class="section-lead leave-lead"><div><span class="eyebrow">LEAVE</span><h2>Leave Management</h2><p>Balance validation and supervisor-to-HR approval.</p></div></section>
 <c:if test="${currentUser.role=='EMPLOYEE'}"><div class="split"><section class="panel"><span class="eyebrow">YOUR BALANCES</span><div class="balance-grid"><c:forEach items="${balances}" var="b"><article><b>${fn:escapeXml(b.available_days)}</b><span>${fn:escapeXml(b.leave_type_name)}</span><small>${fn:escapeXml(b.used_days)} used of ${fn:escapeXml(b.entitled_days)}</small></article></c:forEach></div></section><details class="panel form-panel" open><summary>Apply for leave</summary><form method="post" class="form-grid"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="apply"><label>Leave type<select name="leaveTypeId"><c:forEach items="${leaveTypes}" var="t"><option value="${fn:escapeXml(t.leave_type_id)}">${fn:escapeXml(t.leave_type_name)}</option></c:forEach></select></label><label>Start<input type="date" name="startDate" required></label><label>End<input type="date" name="endDate" required></label><label class="span-2">Reason<textarea name="reason" required maxlength="500"></textarea></label><button class="button primary">Submit request</button></form></details></div></c:if>
 <section class="panel table-panel"><div class="panel-title"><div><span class="eyebrow">REQUEST WORKFLOW</span><h3>Leave history</h3></div><c:if test="${currentUser.role!='EMPLOYEE'}"><a class="button" href="${pageContext.request.contextPath}/export?report=leave">Export CSV</a></c:if></div><div class="table-wrap"><table><thead><tr><th>Employee</th><th>Type</th><th>Dates</th><th>Days</th><th>Reason</th><th>Status</th><c:if test="${currentUser.role!='EMPLOYEE'}"><th>Decision</th></c:if></tr></thead><tbody><c:forEach items="${records}" var="r"><tr><td><b>${fn:escapeXml(r.full_name)}</b><small>${fn:escapeXml(r.employee_code)}</small></td><td>${fn:escapeXml(r.leave_type_name)}</td><td>${fn:escapeXml(r.start_date)}<small>to ${fn:escapeXml(r.end_date)}</small></td><td>${fn:escapeXml(r.days_requested)}</td><td>${fn:escapeXml(r.reason)}</td><td><span class="badge ${r.status=='APPROVED'?'ok':r.status=='REJECTED'?'danger':'warn'}">${fn:escapeXml(r.status)}</span></td><c:if test="${currentUser.role!='EMPLOYEE'}"><td><c:if test="${(currentUser.role=='DEPARTMENT_SUPERVISOR' and r.status=='PENDING_SUPERVISOR') or (currentUser.role=='HR_MANAGER' and r.status=='PENDING_HR')}"><form method="post" class="decision"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="decide"><input type="hidden" name="id" value="${fn:escapeXml(r.leave_request_id)}"><input name="reason" placeholder="Decision reason" required maxlength="500"><button name="decision" value="APPROVE" class="button success">Approve</button><button name="decision" value="REJECT" class="button danger">Reject</button></form></c:if></td></c:if></tr></c:forEach></tbody></table></div></section>
<c:if test="${currentUser.role!='EMPLOYEE'}"><section class="panel table-panel"><h3>Team leave balances</h3><div class="table-wrap"><table><thead><tr><th>Employee</th><th>Type</th><th>Year</th><th>Entitled</th><th>Used</th><th>Remaining</th></tr></thead><tbody><c:forEach items="${balances}" var="b"><tr><td>${fn:escapeXml(b.full_name)}</td><td>${fn:escapeXml(b.leave_type_name)}</td><td>${fn:escapeXml(b.year)}</td><td>${fn:escapeXml(b.entitled_days)}</td><td>${fn:escapeXml(b.used_days)}</td><td>${fn:escapeXml(b.available_days)}</td></tr></c:forEach></tbody></table></div></section></c:if>
<c:if test="${currentUser.role=='EMPLOYEE'}"><c:forEach items="${records}" var="r"><c:if test="${r.status=='PENDING_SUPERVISOR' or r.status=='PENDING_HR'}"><details class="panel form-panel"><summary>Manage pending request #${fn:escapeXml(r.leave_request_id)}</summary><c:if test="${r.status=='PENDING_SUPERVISOR'}"><form method="post" class="form-grid"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="update"><input type="hidden" name="id" value="${fn:escapeXml(r.leave_request_id)}"><input type="hidden" name="leaveTypeId" value="${fn:escapeXml(r.leave_type_id)}"><label>Start<input type="date" name="startDate" value="${fn:escapeXml(r.start_date)}" required></label><label>End<input type="date" name="endDate" value="${fn:escapeXml(r.end_date)}" required></label><label>Reason<input type="text" name="reason" value="${fn:escapeXml(r.reason)}" required maxlength="500"></label><button class="button">Update pending request</button></form></c:if><form method="post" class="form-grid" data-confirm="Cancel this pending leave request?"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="cancel"><input type="hidden" name="id" value="${fn:escapeXml(r.leave_request_id)}"><button class="button danger">Cancel request</button></form></details></c:if></c:forEach></c:if>
</c:when>

<c:when test="${module=='performance'}">
 <%@ include file="includes/tasks.jsp" %>
 <section class="section-lead performance-lead"><div><span class="eyebrow">PERFORMANCE</span><h2>Performance Management</h2><p>Structured reviews, goals, progress and history.</p></div></section>
 <c:if test="${currentUser.role=='OPERATIONS_MANAGER'}"><div class="split"><details class="panel form-panel" open><summary>Record performance review</summary><form method="post" class="form-grid"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="review"><label>Employee<select name="employeeId"><c:forEach items="${employees}" var="e"><option value="${fn:escapeXml(e.employee_id)}">${fn:escapeXml(e.employee_code)} - ${fn:escapeXml(e.full_name)}</option></c:forEach></select></label><label>Review period<select name="periodId"><c:forEach items="${periods}" var="p"><option value="${fn:escapeXml(p.review_period_id)}">${fn:escapeXml(p.period_name)}</option></c:forEach></select></label><label>Overall rating (1-5)<input type="number" name="rating" min="1" max="5" step="0.1" required></label><label class="span-2">Written feedback<textarea name="comments" required></textarea></label><button class="button primary">Save draft review</button></form></details><details class="panel form-panel" open><summary>Set employee goal / KPI</summary><form method="post" class="form-grid"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="goal"><label>Employee<select name="employeeId"><c:forEach items="${employees}" var="e"><option value="${fn:escapeXml(e.employee_id)}">${fn:escapeXml(e.full_name)}</option></c:forEach></select></label><label>Goal title<input name="goalTitle" required></label><label>Target value<input type="number" name="target" min="0.01" step="0.01" required></label><label>Weight %<input type="number" name="weight" min="0" max="100" step="0.1" required></label><label>Due date<input type="date" name="dueDate" required></label><button class="button primary">Create goal</button></form></details></div></c:if>
 <section class="panel"><div class="panel-title"><div><span class="eyebrow">ACTIVE GOALS</span><h3>KPI progress</h3></div></div><div class="goal-grid"><c:forEach items="${goals}" var="g"><article><div><b>${fn:escapeXml(g.title)}</b><span>${fn:escapeXml(g.full_name)}</span></div><strong>${fn:escapeXml(g.current_value)} / ${fn:escapeXml(g.target_value)}</strong><progress value="${fn:escapeXml(g.current_value)}" max="${fn:escapeXml(g.target_value)}"></progress><small>Due ${fn:escapeXml(g.due_date)} &middot; ${fn:escapeXml(g.weight_percent)}% weight &middot; ${fn:escapeXml(g.status)}</small><c:if test="${currentUser.role=='OPERATIONS_MANAGER'}"><form method="post" class="inline"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="progress"><input type="hidden" name="goalId" value="${fn:escapeXml(g.goal_id)}"><input type="number" name="progress" step="0.01" placeholder="Progress" required><input name="note" placeholder="Progress note" required><button class="button">Update</button></form></c:if></article></c:forEach><c:if test="${empty goals}"><p class="empty">No goals are available.</p></c:if></div></section>
 <section class="panel table-panel"><div class="panel-title"><div><span class="eyebrow">REVIEW HISTORY</span><h3>Evaluations (drafts and finalized)</h3></div><c:if test="${currentUser.role!='EMPLOYEE'}"><a class="button" href="${pageContext.request.contextPath}/export?report=performance">Export CSV</a></c:if></div><div class="table-wrap"><table><thead><tr><th>Employee</th><th>Period</th><th>Date</th><th>Rating</th><th>Feedback</th><th>Reviewer</th></tr></thead><tbody><c:forEach items="${records}" var="r"><tr><td>${fn:escapeXml(r.full_name)}</td><td>${fn:escapeXml(r.period_name)}</td><td>${fn:escapeXml(r.review_date)}</td><td><span class="rating">${fn:escapeXml(r.overall_rating)} / 5</span></td><td>${fn:escapeXml(r.comments)}</td><td>${fn:escapeXml(r.reviewer_name)}</td></tr></c:forEach></tbody></table></div></section>
<c:if test="${currentUser.role=='OPERATIONS_MANAGER'}"><section class="panel"><h3>Across-department performance summary</h3><p>Active employees; average of each employee's finalized-review average. Goal counts are calculated separately.</p><%@ include file="includes/summary.jsp" %><a class="button" href="${pageContext.request.contextPath}/export?report=performance-summary">Export summary CSV</a></section>
<c:forEach items="${records}" var="r"><c:if test="${r.status=='DRAFT'}"><details class="panel form-panel"><summary>Draft review #${fn:escapeXml(r.review_id)} — ${fn:escapeXml(r.full_name)}</summary><form method="post" class="form-grid" data-confirm="Apply this draft review action? Finalized reviews are locked."><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="edit"><input type="hidden" name="id" value="${fn:escapeXml(r.review_id)}"><label>Rating<input type="number" name="rating" min="1" max="5" step="0.01" value="${fn:escapeXml(r.overall_rating)}" required></label><label>Feedback<textarea name="comments" required maxlength="1000">${fn:escapeXml(r.comments)}</textarea></label><button name="reviewAction" value="update" class="button">Save draft</button><button name="reviewAction" value="finalize" class="button primary">Finalize</button><button name="reviewAction" value="delete" class="button danger">Delete draft</button></form></details></c:if></c:forEach></c:if>
<section class="panel"><h3>Employee performance history</h3><c:if test="${currentUser.role!='EMPLOYEE'}"><form method="get" class="form-grid"><label>Employee<select name="employeeId"><option value="0">All authorized employees</option><c:forEach items="${employees}" var="person"><option value="${person.employee_id}" ${param.employeeId==person.employee_id?'selected':''}><c:out value="${person.employee_code}"/> — <c:out value="${person.full_name}"/></option></c:forEach></select></label><button class="button">View history</button></form></c:if><c:if test="${currentUser.role!='EMPLOYEE'}"><a class="button" href="${pageContext.request.contextPath}/export?report=performance&amp;employeeId=${empty param.employeeId?0:fn:escapeXml(param.employeeId)}">Export selected history</a></c:if><c:set var="summary" value="${performanceHistory}"/><%@ include file="includes/summary.jsp" %></section>
</c:when>

<c:when test="${module=='payroll'}">
 <section class="section-lead payroll-lead"><div><span class="eyebrow">PAYROLL</span><h2>Payroll Management</h2><p>Fixed monthly salary, configurable statutory rates and auditable results. Open attendance must be resolved before finalization.</p></div></section>
 <c:if test="${currentUser.role=='PAYROLL_SPECIALIST'}"><details class="panel form-panel" open><summary>Process and finalize payroll</summary><form method="post" class="form-grid"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="process"><label>Period label<input name="periodLabel" placeholder="September 2026" required></label><label>Start date<input type="date" name="startDate" required></label><label>End date<input type="date" name="endDate" required></label><button class="button primary" data-confirm-button>Calculate and close run</button></form><p class="hint">Only active employees with salary structures are processed. EPF/ETF rates are applied according to their effective dates.</p></details></c:if>
 <section class="panel table-panel"><div class="panel-title"><div><span class="eyebrow">PAYROLL HISTORY</span><h3>Payroll Records</h3></div><c:if test="${currentUser.role!='EMPLOYEE'}"><a class="button" href="${pageContext.request.contextPath}/export?report=payroll">Export CSV</a></c:if></div><div class="table-wrap"><table><thead><tr><th>Employee</th><th>Period</th><th>Base</th><th>Gross</th><th>Employee EPF</th><th>Employer EPF</th><th>ETF</th><th>Deductions</th><th>Net pay</th><th>Payslip</th></tr></thead><tbody><c:forEach items="${records}" var="r"><tr><td><b>${fn:escapeXml(r.full_name)}</b><small>${fn:escapeXml(r.employee_code)}</small></td><td>${fn:escapeXml(r.period_label)}</td><td>LKR ${fn:escapeXml(r.base_salary)}</td><td>LKR ${fn:escapeXml(r.gross_pay)}</td><td>${fn:escapeXml(r.employee_epf)}</td><td>${fn:escapeXml(r.employer_epf)}</td><td>${fn:escapeXml(r.etf)}</td><td>${fn:escapeXml(r.total_deductions)}</td><td><b>LKR ${fn:escapeXml(r.net_pay)}</b></td><td><c:choose><c:when test="${r.status=='CLOSED'}"><a class="button" href="${pageContext.request.contextPath}/payslip?id=${fn:escapeXml(r.payroll_record_id)}">PDF</a>
</c:when><c:otherwise>${fn:escapeXml(r.status)}</c:otherwise></c:choose></td></tr></c:forEach><c:if test="${empty records}"><tr><td colspan="10" class="empty">No payroll records available.</td></tr></c:if></tbody></table></div></section>
<c:if test="${currentUser.role=='PAYROLL_SPECIALIST'}"><details class="panel form-panel"><summary>Set base salary for a new effective month</summary><form method="post" class="form-grid"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="salary"><label>Employee<select name="employeeId"><c:forEach items="${employees}" var="person"><c:if test="${person.status=='ACTIVE'}"><option value="${person.employee_id}"><c:out value="${person.employee_code}"/> — <c:out value="${person.full_name}"/></option></c:if></c:forEach></select></label><label>Monthly base salary<input type="number" min="0" step="0.01" name="base" required></label><label>Effective month start<input type="date" name="effectiveDate" required></label><button class="button primary">Save salary structure</button></form><p class="hint">Existing salary history is retained. Salary used by a draft or finalized payroll cannot be changed; adjust a draft's amounts or use a later effective month.</p></details></c:if>
<section class="panel"><h3>Payroll period filter</h3><form method="get" class="form-grid"><label>From<input type="date" name="from" value="${from}" required></label><label>To<input type="date" name="to" value="${to}" required></label><button class="button">Filter</button></form><c:if test="${currentUser.role!='EMPLOYEE'}"><a class="button" href="${pageContext.request.contextPath}/export?report=payroll&amp;from=${from}&amp;to=${to}">Export selected period</a></c:if></section><c:if test="${currentUser.role=='PAYROLL_SPECIALIST'}"><details class="panel form-panel"><summary>Create editable draft payroll</summary><form method="post" class="form-grid"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="draft"><label>Period label<input type="text" name="periodLabel" required maxlength="80"></label><label>Month start<input type="date" name="startDate" required></label><label>Month end<input type="date" name="endDate" required></label><button class="button primary">Calculate draft</button></form></details><c:forEach items="${records}" var="r"><c:if test="${r.status=='DRAFT'}"><details class="panel form-panel"><summary>${fn:escapeXml(r.employee_code)} — ${fn:escapeXml(r.full_name)}</summary><form method="post" class="form-grid"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="update"><input type="hidden" name="id" value="${fn:escapeXml(r.payroll_record_id)}"><label>Base salary<input type="number" name="base" min="0" step="0.01" value="${fn:escapeXml(r.base_salary)}" required></label><label>Allowances<input type="number" name="allowances" min="0" step="0.01" value="${r.gross_pay-r.base_salary}" required></label><label>Other deductions<input type="number" name="deductions" min="0" step="0.01" value="${fn:escapeXml(r.total_deductions)}" required></label><button class="button">Recalculate draft record</button></form></details></c:if></c:forEach><c:forEach items="${runs}" var="r"><c:if test="${r.status=='DRAFT'}"><section class="panel"><h3>Draft run ${fn:escapeXml(r.period_label)}</h3><form method="post" class="form-grid" data-confirm="Apply this payroll action? Finalized payroll cannot be edited."><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="lifecycle"><input type="hidden" name="id" value="${fn:escapeXml(r.payroll_run_id)}"><button name="runAction" value="finalize" class="button primary">Finalize run</button><button name="runAction" value="cancel" class="button danger">Cancel draft run</button></form></section></c:if></c:forEach></c:if>
</c:when>

<c:when test="${module=='access'}">
 <section class="section-lead access-lead"><div><span class="eyebrow">USER ACCESS</span><h2>User Access Management</h2><p>Accounts, roles, status and auditable security actions.</p></div></section>
 <details class="panel form-panel"><summary>Create staff account</summary><form method="post" class="form-grid"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="create"><label>Employee<select name="employeeId"><c:forEach items="${employees}" var="e"><option value="${fn:escapeXml(e.employee_id)}">${fn:escapeXml(e.employee_code)} - ${fn:escapeXml(e.full_name)}</option></c:forEach></select></label><label>Role<select name="roleId"><c:forEach items="${roles}" var="r"><option value="${fn:escapeXml(r.role_id)}">${fn:escapeXml(r.role_name)}</option></c:forEach></select></label><label>Username<input name="username" required></label><label>Email<input type="email" name="email" required></label><label>Temporary password<input type="password" name="password" minlength="8" required></label><button class="button primary">Create account</button></form></details>
 <section class="panel table-panel"><div class="panel-title"><div><span class="eyebrow">ACCESS DIRECTORY</span><h3>User accounts</h3></div></div><div class="table-wrap"><table><thead><tr><th>User</th><th>Role</th><th>Status</th><th>Last login</th><th>Security action</th></tr></thead><tbody><c:forEach items="${records}" var="r"><tr><td><b>${fn:escapeXml(r.full_name)}</b><small>${fn:escapeXml(r.username)} &middot; ${fn:escapeXml(r.email)}</small></td><td>${fn:escapeXml(r.role_code)}</td><td><span class="badge ${r.status=='ACTIVE'?'ok':r.status=='LOCKED'?'danger':'muted'}">${fn:escapeXml(r.status)}</span><small>${fn:escapeXml(r.failed_attempts)} failed attempts</small></td><td>${fn:escapeXml(r.last_login_at)}</td><td><form method="post" class="decision" data-confirm="Apply this account security action?"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="account"><input type="hidden" name="id" value="${fn:escapeXml(r.user_id)}"><input type="password" name="temporaryPassword" placeholder="Temp password for reset" autocomplete="new-password"><button name="accountAction" value="activate" class="button success">Activate</button><button name="accountAction" value="deactivate" class="button danger">Deactivate</button><button name="accountAction" value="unlock" class="button">Unlock</button><button name="accountAction" value="reset" class="button">Reset</button></form></td></tr></c:forEach></tbody></table></div></section>
<section class="panel"><h3>Search accounts</h3><form method="get" class="form-grid"><label>Name / username<input name="q" value="${fn:escapeXml(param.q)}"></label><label>Role<select name="role"><option value="">All roles</option><c:forEach items="${roles}" var="r"><option value="${fn:escapeXml(r.role_code)}">${fn:escapeXml(r.role_name)}</option></c:forEach></select></label><label>Status<select name="status"><option value="">All</option><option>ACTIVE</option><option>INACTIVE</option><option>LOCKED</option></select></label><button class="button">Filter</button></form><a class="button" href="${pageContext.request.contextPath}/app/reports">Review account audit history</a></section><c:forEach items="${records}" var="r"><c:if test="${r.user_id!=currentUser.id}"><details class="panel form-panel"><summary>Update account #${fn:escapeXml(r.user_id)} — ${fn:escapeXml(r.username)}</summary><form method="post" class="form-grid"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="update"><input type="hidden" name="id" value="${fn:escapeXml(r.user_id)}"><label>Email<input type="email" name="email" value="${fn:escapeXml(r.email)}" required></label><label>Role<select name="roleId"><c:forEach items="${roles}" var="role"><option value="${fn:escapeXml(role.role_id)}" ${role.role_id==r.role_id?'selected':''}>${fn:escapeXml(role.role_name)}</option></c:forEach></select></label><button class="button">Update account and revoke sessions</button></form></details></c:if></c:forEach><p class="hint">Temporary passwords expire after 24 hours. Reset preserves inactive status; activate explicitly where appropriate. Your own administrative account cannot be changed here.</p>
</c:when>

<c:when test="${module=='reports'}">
 <section class="section-lead report-lead"><div><span class="eyebrow">REPORTS</span><h2>Reports and Audit</h2><p>Download authorized operational data and inspect the audit trail.</p></div></section><div class="report-cards"><c:forEach items="${reportNames}" var="name"><a href="${pageContext.request.contextPath}/export?report=${name}"><b>${name.toUpperCase()}</b><span>Download CSV report</span></a></c:forEach></div><c:if test="${currentUser.role=='IT_SYSTEM_ADMINISTRATOR'}"><section class="panel table-panel"><div class="panel-title"><div><span class="eyebrow">AUDIT TRAIL</span><h3>Sensitive system activity</h3></div></div><div class="table-wrap"><table><thead><tr><th>User</th><th>Action</th><th>Entity</th><th>Details</th><th>Time</th></tr></thead><tbody><c:forEach items="${records}" var="r"><tr><td>${fn:escapeXml(r.username)}</td><td><span class="badge">${fn:escapeXml(r.action_name)}</span></td><td>${fn:escapeXml(r.entity_type)} #${fn:escapeXml(r.entity_id)}</td><td>${fn:escapeXml(r.details)}</td><td>${fn:escapeXml(r.created_at)}</td></tr></c:forEach></tbody></table></div></section></c:if>
</c:when>

<c:when test="${module=='notifications'}">
 <section class="section-lead"><div><span class="eyebrow">IN-APP NOTIFICATION CENTRE</span><h2>Notifications</h2><p>Your account notifications.</p></div><form method="post"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="all"><button class="button">Mark all read</button></form></section><div class="notification-list"><c:forEach items="${records}" var="r"><article class="${r.is_read?'read':'unread'}"><span class="notification-type">${fn:escapeXml(r.notification_type)}</span><div><h3>${fn:escapeXml(r.title)}</h3><p>${fn:escapeXml(r.message)}</p><small>${fn:escapeXml(r.created_at)}</small></div><div><c:if test="${!r.is_read}"><form method="post"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="read"><input type="hidden" name="id" value="${fn:escapeXml(r.notification_id)}"><button class="link-button">Mark read</button></form></c:if><form method="post"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="${fn:escapeXml(r.notification_id)}"><button class="link-button danger-text">Delete</button></form></div></article></c:forEach><c:if test="${empty records}"><p class="empty">You have no notifications.</p></c:if></div>
</c:when>

<c:when test="${module=='account'}">
 <%@ include file="includes/profile.jsp" %>
 <section class="section-lead access-lead"><div><span class="eyebrow">ACCOUNT SECURITY</span><h2>Password Settings</h2><p>Change the temporary or current password for <b>${fn:escapeXml(currentUser.username)}</b>.</p></div></section><section class="panel account-card"><form method="post" class="form-grid"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="password"><label>Current password<input type="password" name="currentPassword" required></label><label>New password<input type="password" name="newPassword" minlength="8" required><small>At least 8 characters, one uppercase letter and one number.</small></label><button class="button primary">Change password</button></form></section>
</c:when>
</c:choose>
</div><%@ include file="includes/foot.jsp" %>
