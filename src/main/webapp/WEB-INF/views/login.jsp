<%@ include file="includes/head.jsp" %>
<div class="auth-page"><section class="auth-story"><a class="brand light" href="${pageContext.request.contextPath}/"><span class="brand-mark">PS</span><span><b>PeopleSphere</b><small>Employee Management</small></span></a><div><span class="pill">Secure workforce operations</span><h1>Employee Management System</h1><p>Sign in to manage your employee information and work records.</p></div><small>PeopleSphere EMS</small></section><section class="auth-panel"><form class="auth-card" method="post"><span class="eyebrow">Authorized users only</span><h2>Sign in</h2><p>Use your assigned EMS account.</p><c:if test="${not empty error}"><div class="alert error"><c:out value="${error}"/></div></c:if><c:if test="${param.logout=='1'}"><div class="alert success">You have signed out safely.</div></c:if><label>Username<input name="username" autocomplete="username" required autofocus></label><label>Password<input type="password" name="password" autocomplete="current-password" required></label><button class="button primary wide">Sign in securely</button></form></section></div></body></html>
