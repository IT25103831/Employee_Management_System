<div class="table-wrap"><table><thead><tr><c:if test="${not empty summary}"><c:forEach items="${summary[0]}" var="cell"><th><c:out value="${cell.key}"/></th></c:forEach></c:if></tr></thead><tbody><c:forEach items="${summary}" var="row"><tr><c:forEach items="${row}" var="cell"><td><c:out value="${cell.value}"/></td></c:forEach></tr></c:forEach><c:if test="${empty summary}"><tr><td class="empty">No matching records.</td></tr></c:if></tbody></table></div>