<c:if test="${currentUser.role=='OPERATIONS_MANAGER' or currentUser.role=='EMPLOYEE'}">
<section class="panel"><h2>${currentUser.role=='EMPLOYEE'?'My Tasks':'Employee Tasks'}</h2>
<c:if test="${currentUser.role=='OPERATIONS_MANAGER'}"><details class="form-panel"><summary>Create task</summary><form method="post" class="form-grid"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="taskAssign">
<label>Employee<select name="employeeId" required><c:forEach items="${taskEmployees}" var="person"><c:if test="${person.status=='ACTIVE'}"><option value="${person.employee_id}"><c:out value="${person.employee_code}"/> — <c:out value="${person.full_name}"/></option></c:if></c:forEach></select></label>
<label>Task title<input name="taskTitle" maxlength="180" required></label><label>Deadline<input type="date" name="deadline" required></label>
<label>Details<textarea name="details" maxlength="2000" required></textarea></label><label>Instructions / notes<textarea name="notes" maxlength="2000"></textarea></label><button class="button primary">Assign task</button></form></details></c:if>
<c:forEach items="${tasks}" var="task"><article class="panel"><h3><c:out value="${task.title}"/></h3><p><c:out value="${task.employee_code}"/> — <c:out value="${task.full_name}"/> · Due <c:out value="${task.deadline}"/> · <span class="badge"><c:out value="${task.status}"/></span></p>
<p class="task-text"><c:out value="${task.details}"/></p><p class="task-text"><b>Instructions:</b> <c:out value="${task.instructions}"/></p>
<c:if test="${not empty task.completion_comments}"><p class="task-text"><b>Completion comments:</b> <c:out value="${task.completion_comments}"/></p><p>Completed: <c:out value="${task.completed_at}"/></p></c:if>
<c:if test="${task.status=='REVIEWED'}"><p class="task-text"><b>Feedback:</b> <c:out value="${task.feedback}"/></p><p>Evaluation: <c:out value="${task.rating}"/> / 5 · Reviewed: <c:out value="${task.reviewed_at}"/></p></c:if>
<c:if test="${currentUser.role=='EMPLOYEE' and task.status=='ASSIGNED'}"><form method="post" class="form-grid" data-confirm="Mark this task as completed and send it for review?"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="taskComplete"><input type="hidden" name="id" value="${task.task_id}"><label>Completion comments<textarea name="comments" maxlength="2000" required></textarea></label><button class="button primary">Complete task</button></form></c:if>
<c:if test="${currentUser.role=='OPERATIONS_MANAGER'}"><c:if test="${task.status=='COMPLETED'}"><form method="post" class="form-grid"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="taskReview"><input type="hidden" name="id" value="${task.task_id}"><label>Rating (1–5)<input type="number" name="rating" min="1" max="5" step="0.01" required></label><label>Feedback<textarea name="feedback" maxlength="2000" required></textarea></label><button class="button primary">Save evaluation</button></form></c:if>
<form method="post" class="form-grid" data-confirm="Delete this task? Its audit history will be retained."><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="taskDelete"><input type="hidden" name="id" value="${task.task_id}"><label>Deletion reason<input name="reason" maxlength="500" required></label><button class="button danger">Delete task</button></form></c:if>
</article></c:forEach><c:if test="${empty tasks}"><p>No tasks available.</p></c:if></section></c:if>
